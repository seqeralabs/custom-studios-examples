#!/bin/bash
# Studio entrypoint: resolve ports, then hand off to s6.
set -euo pipefail

# The studio proxy owns CONNECT_TOOL_PORT and webtop's own nginx stays internal, so
# the Studio port is bound before the desktop is ready. See studio-proxy-run.
export STUDIO_PROXY_PORT="${CONNECT_TOOL_PORT:-3000}"
export WEBTOP_UPSTREAM_PORT=3000
if [ "$STUDIO_PROXY_PORT" = "$WEBTOP_UPSTREAM_PORT" ]; then
    export WEBTOP_UPSTREAM_PORT=3002
fi
export CUSTOM_PORT="$WEBTOP_UPSTREAM_PORT"

echo "[studio] CONNECT_TOOL_PORT=${CONNECT_TOOL_PORT:-UNSET} proxy=$STUDIO_PROXY_PORT upstream=$CUSTOM_PORT pid=$$"

# Hand off to s6-overlay.
#
# s6-overlay's /init must be pid 1: it execs s6-overlay-suexec, which aborts with
# "s6-overlay-suexec: fatal: can only run as pid 1" otherwise. connect-client runs the
# tool as a child process rather than exec'ing it, so under Studios that check fails
# and the session dies seconds after starting.
#
# Skipping suexec is not an option: preinit reads the UID/EUID/GID environment that
# suexec sets up ("test: Illegal number:" without it), and stage0 documents itself as
# "run as pid 1" and execs a real init that needs a runlevel. So give /init a PID
# namespace of its own instead, where it is pid 1 for real. This needs CAP_SYS_ADMIN,
# which the Studio container has (it sets up loop devices, btrfs and FUSE mounts).
if [ "$$" = "1" ]; then
    exec /init
fi

# --mount-proc implies --mount, giving /proc that matches the new namespace. Fall back
# to a bare PID namespace if the mount propagation change is refused.
if unshare --pid --fork --mount-proc true 2>/dev/null; then
    echo "[studio] pid is $$, re-executing /init in a PID namespace (with /proc)"
    exec unshare --pid --fork --mount-proc /init
elif unshare --pid --fork true 2>/dev/null; then
    echo "[studio] pid is $$, re-executing /init in a PID namespace"
    exec unshare --pid --fork /init
fi

echo "[studio] fatal: pid is $$, not 1, and no PID namespace available." >&2
echo "[studio] s6-overlay requires pid 1; check that the container has CAP_SYS_ADMIN." >&2
unshare --pid --fork true || true
exit 1
